# URL base de la API. Vacio = usa el proxy de Vite (/api).
VITE_API_URL=

# CARTO API Key para capas de mapa y georreferenciación de alta demanda
VITE_CARTO_API_KEY=

# Interruptor de arrendamientos. El valor por defecto (apagado) vive en
# src/app/config/features.js; esta variable permite encenderlo por ambiente.
VITE_FEATURE_ARRIENDOS=false
